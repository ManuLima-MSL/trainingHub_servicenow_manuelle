        <name>Validate Instructor</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var scheduleId = g_form.getValue('schedule');  
    var currentUserId = g_user.userID;  

    var grSchedule = new GlideRecord('x_1593183_traini_0_training_schedules');
    if (grSchedule.get(scheduleId)) {
        var instructorId = grSchedule.instructor;  

        
        if (instructorId == currentUserId) {
            
            g_form.addErrorMessage('Você não pode se inscrever no seu próprio curso.', 'error');
			return false;  
        }
    }
    
    return true;  
}
]]></script>
