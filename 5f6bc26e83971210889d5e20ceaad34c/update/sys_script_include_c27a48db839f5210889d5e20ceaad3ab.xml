        <script><![CDATA[var ScheduleUtils = Class.create();
ScheduleUtils.prototype = {
    initialize: function() {},

    checkScheduleConflict: function(courseId, newScheduleDate) {
        var gr = new GlideRecord('x_1593183_traini_0_training_schedules');
        gr.addQuery('course', courseId);          // Filtro pelo curso
        gr.addQuery('training_date', newScheduleDate); // Filtro pela data do novo schedule
        gr.query();

        if (gr.next()) {
            return 'false';  // Já existe um schedule para esse curso na mesma data
        }
        return 'true';  // Nenhum schedule encontrado
    },

    type: 'ScheduleUtils'
};
]]></script>
