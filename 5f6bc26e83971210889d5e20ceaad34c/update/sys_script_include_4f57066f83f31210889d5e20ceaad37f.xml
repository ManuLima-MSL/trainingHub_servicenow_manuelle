        <script><![CDATA[var CourseSchedulesUtils = Class.create();
CourseSchedulesUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	courseSchedules: function(courseId, variable){
		
		var grCourse = new GlideRecord("x_1593183_traini_0_training_schedules");
		grCourse.addQuery('sys_id', courseId);
		grCourse.query();

		if(grCourse.next()){
			return grCourse.getValue(variable);
		}
	},

	fillSchedules: function(){
		var courseId = this.getParameter('sysparm_course_sysId');
		return this.courseSchedules(courseId, 'full_display_value');
	},

    type: 'CourseSchedulesUtils'
});]]></script>
