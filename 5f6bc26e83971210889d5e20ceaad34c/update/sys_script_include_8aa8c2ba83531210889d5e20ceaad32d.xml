        <script><![CDATA[var TrainingScheduleValidator = Class.create();
TrainingScheduleValidator.prototype = {
    initialize: function() {},
    
    validateTrainingSchedule: function(courseID, trainingDate) {
        var grSchedule = new GlideRecord('x_1593183_traini_0_training_schedules');
        grSchedule.addQuery('course', courseID);
        grSchedule.addQuery('training_date', trainingDate);
        grSchedule.query();
        
        if (grSchedule.next()) {
            return 'true'; 
        } else {
            return 'false'; 
        }
    },

    type: 'TrainingScheduleValidator'
};
]]></script>
