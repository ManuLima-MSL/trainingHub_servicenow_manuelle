        <script><![CDATA[// Script Include: TrainingUtils
var TrainingUtils = Class.create();
TrainingUtils.prototype = {
    initialize: function() {},

    getEnrolledSchedules: function(userId) {  // Aceita o userId como parâmetro
        var enrolledSchedules = [];
        var grEnrollment = new GlideRecord("x_1593183_traini_0_training_enrollments");
        grEnrollment.addQuery("user", userId); // Usa o userId fornecido
        grEnrollment.query();
        while (grEnrollment.next()) {
            enrolledSchedules.push(grEnrollment.schedule.toString()); // Adiciona o sys_id da agenda
        }
        return enrolledSchedules;
    },

    type: 'TrainingUtils'
};]]></script>
