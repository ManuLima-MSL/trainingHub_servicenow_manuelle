        <messages/>
        <name>Validate Instructor RP</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {
    // Obtém o ID do Schedule selecionado e o ID do usuário atual
    var scheduleId = g_form.getValue('schedule');  // Campo que referencia o Schedule
    var currentUserId = g_user.getID();  // Obtém o ID do usuário atual

    // Realiza a consulta para pegar o instrutor do curso
    var grSchedule = new GlideRecord('x_1593183_traini_0_training_schedules');
    if (grSchedule.get(scheduleId)) {
        var instructorId = grSchedule.instructor;  // Campo que armazena o instrutor

        // Verifica se o instrutor é o mesmo que o usuário atual
        if (instructorId == currentUserId) {
            // Impede a matrícula e exibe uma mensagem de erro
            g_form.addErrorMessage('schedule', 'Você não pode se inscrever no seu próprio curso.', 'error');
            return false;  // Impede a submissão do formulário
        }
    }
    
    return true;  // Permite a submissão do formulário se a condição não for atendida
}
]]></script>
