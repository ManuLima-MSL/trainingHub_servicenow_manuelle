        <name>Validate Training Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }
        }
        var ga = new GlideAjax('CheckTrainingDate');
        ga.addParam('sysparm_name', 'checkDateConflict');
        ga.addParam('sysparm_course', g_form.getValue("course"));
        ga.addParam('sysparm_date', g_form.getValue("training_date"));

        ga.getXMLAnswer(function(response) {
            if (response == "conflict") {
                g_form.clearValue('training_date');  // Limpa a data inválida
