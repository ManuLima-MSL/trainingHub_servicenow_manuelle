        <name>Check Training Date</name>
        <onclick>check_training_date()</onclick>
        <order>100</order>
        <script><![CDATA[var course = g_form.getValue('course'); // Obtenha o curso do formulário
var date = g_form.getValue('training_date'); // Obtenha a data do formulário

// Verifique se já existe um treinamento agendado para o mesmo curso e data
var gr = new GlideRecord('x_1593183_traini_0_training_schedules'); // Substitua your_training_table pelo nome da sua tabela de treinamentos
gr.addQuery('course', course);
gr.addQuery('training_date', date);
gr.query();

if (gr.next()) {
  
  g_form.addErrorMessage("Error: There is already a training scheduled for this course on this date");
  g_form.setAbortOnSubmit(true);
}]]></script>
