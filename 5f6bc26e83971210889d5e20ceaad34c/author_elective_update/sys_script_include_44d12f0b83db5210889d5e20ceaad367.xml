        <description/>
        <mobile_callable>false</mobile_callable>
        <name>TrainingCoursesUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingCoursesUtils = Class.create();
TrainingCoursesUtils.prototype = {
    initialize: function() {
    },
	canEnroll: function(courseId, userId) {
        var enrollmentCount = 0;
        var grEnrollments = new GlideRecord('x_1593183_traini_0_training_enrollments');
        grEnrollments.addQuery('course', courseId);  // Filtro pelo curso
        grEnrollments.addQuery('opened_by', userId); // Filtro pelo usuário
        grEnrollments.query();
        
        while (grEnrollments.next()) {
            enrollmentCount++;
        }

        if (enrollmentCount >= 3) {
            return false;  // Retorna falso se o usuário já estiver matriculado 3 vezes
        }
        
        return true;  // Retorna verdadeiro se o usuário ainda puder se matricular
    },
    type: 'TrainingCoursesUtils'
};]]></script>
