        <script><![CDATA[var TrainingUtils = Class.create();
TrainingUtils.prototype = {
    initialize: function() {},

    refQualTraining: function(userId) {
        var notShowSchedules = [];
        var availableSchedules = [];

        // Pega a data atual (sem a parte da hora)
        var today = new GlideDateTime(); // Pega data e hora atuais
        today = today.getDate(); // Extrai apenas a data (sem a parte da hora)

        var scheduleQuery = new GlideRecord('x_1593183_traini_0_training_schedules');
        scheduleQuery.addQuery('training_date', '>=', today); // Compara apenas com a data (sem hora)
        scheduleQuery.query();

        while (scheduleQuery.next()) {
            var scheduleId = scheduleQuery.getUniqueValue(); // sys_id do treinamento
            var maxSeats = scheduleQuery.max_students; // Lotação máxima
            var availableSeats = maxSeats - scheduleQuery.seats_available; // Vagas restantes
            var instructorId = scheduleQuery.instructor; // ID do instrutor
            var startDate = scheduleQuery.training_date; // A data de treinamento (do tipo Date)

            // Verificar se o usuário já está inscrito
            var userRegistered = false;
            var regCheck = new GlideRecord('x_1593183_traini_0_training_enrollments');
            regCheck.addQuery('opened_by', userId);
            regCheck.addQuery('schedule', scheduleId);
            regCheck.query();
            if (regCheck.hasNext()) {
                userRegistered = true;
            }

            // Verificar as condições para adicionar à lista de não mostrar
            if (
                userRegistered || // Já está cadastrado
                availableSeats <= 0 || // Sem vagas disponíveis
                instructorId == userId || // É o instrutor do treinamento
                startDate < today // A data de treinamento já passou (ou é hoje)
            ) {
                notShowSchedules.push(scheduleId); // Agenda que não deve ser mostrada
            } else {
                availableSchedules.push(scheduleId); // Agenda disponível
            }

        }

        // Retorna apenas as agendas disponíveis, separadas por vírgula
        return availableSchedules.join(",");

    },

    type: 'TrainingUtils'
};
]]></script>
